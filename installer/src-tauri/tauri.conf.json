{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Onion Installer",
  "version": "0.1.0",
  "identifier": "org.onionui.installer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Onion Installer", "width": 640, "height": 640, "minWidth": 560, "minHeight": 600, "resizable": true, "theme": "Dark", "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
